# Copia este archivo a .env y llénalo para probar en tu máquina.
# En GitHub Actions estos valores van como "Secrets", NO en el repo.

GEMINI_API_KEY=
META_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=

# Solo para pruebas locales de la subida (en Actions se inyecta solo):
GITHUB_TOKEN=
GITHUB_REPOSITORY=tu-usuario/tu-repo

# Opcionales
GRAPH_VERSION=v23.0
GEMINI_MODEL=gemini-2.5-flash
NICHE=tecnología y finanzas
TTS_VOICE=es-MX-JorgeNeural
# En Windows local usa Arial (DejaVu Sans no viene instalada):
# SUB_FONT=Arial
# BG_VIDEO=assets/fondo.mp4
